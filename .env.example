# --- Foundry project ---
# e.g. https://<your-resource>.services.ai.azure.com/api/projects/<your-project>
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_MODEL=gpt-5.1

# --- Toolbox config ---
TOOLBOX_NAME=meeting-mins-toolbox

# Filled in after `uv run python build_toolbox.py` prints it.
FOUNDRY_TOOLBOX_ENDPOINT=

# --- AI Search tool wiring (internal grounding) ---
# Use the EXACT name Foundry assigned to your AI Search connection
# (it may have an auto-suffix, e.g. aisearchcorepo7u7j).
SEARCH_CONNECTION_NAME=
SEARCH_INDEX_NAME=
AZURE_SEARCH_ENDPOINT=

# --- Web search tool (external grounding via Bing) ---
# Set to false to omit the web search tool from the toolbox.
# When enabled, Foundry routes web_search to the project's
# Grounding-with-Bing connection automatically — no extra wiring needed here.
ENABLE_WEB_SEARCH=true

AGENT_NAME=toolbox-test-agent

# --- Observability ---
# A per-run summary table (tool calls, durations, tokens) always prints.
# Set to true to ALSO enable OpenTelemetry instrumentation with a console
# span exporter for full distributed traces (chat client + MCP tools).
ENABLE_OTEL_CONSOLE=false
